{
  "name": "tecmov-rma",
  "version": "0.3.0",
  "private": true,
  "description": "Gestión local de ingresos y garantías RMA",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/persistence.test.js tests/restore.test.js tests/license.test.js",
    "dist:win": "electron-builder --win nsis --publish never"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "ar.com.tecmov.rma",
    "productName": "TECMOV RMA",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "modules.js",
      "store.js",
      "index.html",
      "renderer.js",
      "style.css",
      "tecmov-logo.png",
      "package.json",
      "logo-transparent.js",
      "license.js"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TECMOV RMA",
      "deleteAppDataOnUninstall": false
    },
    "asar": true,
    "compression": "maximum"
  },
  "author": "TECMOV Accesorios"
}
